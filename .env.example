# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used by processing-service only. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — used by processing-service to verify Supabase Auth tokens server-side.
# Find it at: Supabase project → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Routing: intake → processing (shared by both services) ────────────────────
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTH_TOKEN=your-shared-internal-token-here

# intake-service: where to reach processing-service (default: local dev)
PROCESSING_SERVICE_URL=http://localhost:8002

# ── Processing service: envelope encryption ───────────────────────────────────
# 32-byte random key, base64-encoded. Generate one with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=your-base64-encoded-32-byte-key-here

# ── Model (optional override) ─────────────────────────────────────────────────
# Model used for key validation test calls (default: claude-haiku-4-5-20251001)
# DEFAULT_MODEL=claude-haiku-4-5-20251001

# ── CORS (optional overrides) ─────────────────────────────────────────────────
# Default: ["http://localhost:3000"]. Override as a JSON array:
# CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ── Logging (optional) ────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
